# ===== 阶段① 基础配置（必填）=====
DATABASE_URL=mysql+pymysql://lab_user:CHANGE_ME@127.0.0.1:3306/lab?charset=utf8mb4
JWT_SECRET_KEY=CHANGE_ME_RANDOM_64_HEX
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ===== 阶段② 大模型（具体供应商待确认；openai 是 LangChain 兼容协议驱动示例）=====
LLM_API_KEY=
LLM_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
LLM_MODEL="GLM-5.3-Flash"
LLM_MODEL_PROVIDER="openai"
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.2
LLM_STREAM_ENABLED=false

# ===== 阶段③ RAG Embedding =====
# api：使用 OpenAI 兼容 Embedding API；local：使用本地 Sentence Transformers
RAG_EMBEDDING_BACKEND=api
# 【待确认】Embedding API 是否与聊天模型同供应商；支持时可复用 LLM_API_KEY / LLM_BASE_URL
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_BASE_URL=
# 【待确认】必须填写供应商实际支持的 Embedding 模型名，与 LLM_MODEL 分开
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_TIMEOUT_SECONDS=60
RAG_LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_LOCAL_DEVICE=cpu
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=4
RAG_MIN_RELEVANCE_SCORE=0.2

# ===== AI Feature Flags（默认全关 = 纯传统业务，main 永远可部署）=====
AI_ENABLED=true
AI_TOOLS_ENABLED=false
AI_WRITE_TOOLS_ENABLED=false

# RAG 向量库路径固定在 backend/data/chroma；检索语料放在 backend/data/kb。
